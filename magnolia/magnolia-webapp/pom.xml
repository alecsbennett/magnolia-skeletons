<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>info.magnolia.dx</groupId>
    <artifactId>magnolia</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>magnolia-webapp</artifactId>
  <name>tbscg-magnolia: webapp</name>
  <packaging>war</packaging>
  <properties>
    <!-- License properties - set via Maven system properties from magnolia-cargo.properties -->
    <!-- Default to empty string if not provided to avoid literal ${property} in JVM args -->
    <magnolia.license.owner></magnolia.license.owner>
    <magnolia.license.key></magnolia.license.key>
    <magnolia.superuser.bootstrap.password></magnolia.superuser.bootstrap.password>
    <magnolia.profile>development</magnolia.profile>
    <magnolia.repositories.jackrabbit.config>WEB-INF/config/repo-conf/jackrabbit-bundle-h2-search.xml</magnolia.repositories.jackrabbit.config>
    <cargo.magnolia.repositories.home>${project.build.directory}/../../../tomcat/Repos/author</cargo.magnolia.repositories.home>
    <cargo.magnolia.logs.dir>${project.build.directory}/../../../tomcat/logs/author</cargo.magnolia.logs.dir>
    <cargo.magnolia.resources.dir>${project.basedir}/../../../light-modules</cargo.magnolia.resources.dir>
  </properties>
  <dependencies>
    <dependency>
      <groupId>info.magnolia.dx</groupId>
      <artifactId>magnolia-dx-core-webapp</artifactId>
      <type>war</type>
    </dependency>
    <dependency>
      <groupId>info.magnolia.dx</groupId>
      <artifactId>magnolia-dx-core-webapp</artifactId>
      <type>pom</type>
    </dependency>
    <!-- Custom modules -->
    <dependency>
      <groupId>com.tbscg.magnolia</groupId>
      <artifactId>content-transfer</artifactId>
      <version>${content-transfer.version}</version>
    </dependency>
    <dependency>
      <groupId>com.tbscg.magnolia</groupId>
      <artifactId>extended-bootstrap</artifactId>
      <version>${extended-bootstrap.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>${maven.war.plugin.version}</version>
        <configuration>
          <!-- exclude jars copied "physically" from the webapp overlay - so we only get those resolved by Maven's dependency management -->
          <dependentWarExcludes>WEB-INF/lib/*.jar</dependentWarExcludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.cargo</groupId>
        <artifactId>cargo-maven3-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>author</id>
      <properties>
        <magnolia.profile>local</magnolia.profile>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.cargo</groupId>
            <artifactId>cargo-maven3-plugin</artifactId>
            <configuration>
              <container>
                <containerId>tomcat11x</containerId>
                <artifactInstaller>
                  <groupId>org.apache.tomcat</groupId>
                  <artifactId>tomcat</artifactId>
                  <version>${tomcat.version}</version>
                  <type>zip</type>
                  <extractDir>${project.build.directory}/../../../tomcat/extracts</extractDir>
                </artifactInstaller>
                <log>${project.build.directory}/../../../tomcat/logs/author/cargo.log</log>
                <output>${project.build.directory}/../../../tomcat/logs/author/tomcat.log</output>
                <timeout>12000000</timeout>
                <append>false</append>
              </container>
              <configuration>
                <home>${project.build.directory}/../../../tomcat/cargo-author</home>
                <type>standalone</type>
                <properties>
                  <cargo.servlet.port>8080</cargo.servlet.port>
                  <cargo.rmi.port>8206</cargo.rmi.port>
                  <cargo.logging>medium</cargo.logging>
                  <cargo.tomcat.shutdown.port>8005</cargo.tomcat.shutdown.port>
                  <cargo.tomcat.ajp.port>8009</cargo.tomcat.ajp.port>
                  <cargo.tomcat.shutdown>180000</cargo.tomcat.shutdown>
                  <cargo.jvmargs>
                    -Xms2g 
                    -Xmx4g
                    -XX:+UnlockExperimentalVMOptions
                    -XX:+EnableJVMCI
                    -Djava.awt.headless=true
                    -Dsun.io.useCanonCaches=false
                    --add-opens=java.base/java.io=ALL-UNNAMED
                    --add-opens=java.base/java.lang=ALL-UNNAMED
                    --add-opens=java.base/java.lang.reflect=ALL-UNNAMED
                    --add-opens=java.base/java.util=ALL-UNNAMED
                    -DMAGNOLIA_PROFILE=${magnolia.profile}
                    -Dmagnolia.repositories.jackrabbit.config=${magnolia.repositories.jackrabbit.config}
                    -Dmagnolia.repositories.home=${cargo.magnolia.repositories.home}
                    -Dmagnolia.logs.dir=${cargo.magnolia.logs.dir}
                    -Dmagnolia.resources.dir=${cargo.magnolia.resources.dir}
                    -Dmagnolia.publishing.receivers[0].name=magnoliaPublic
                    -Dmagnolia.publishing.receivers[0].url=http://localhost:8081/
                    -Dmagnolia.publishing.receivers[0].enabled=true
                    -Dmagnolia.license.owner=${magnolia.license.owner}
                    -Dmagnolia.license.key=${magnolia.license.key}
                    -Dmagnolia.superuser.bootstrap.password=${magnolia.superuser.bootstrap.password}
                  </cargo.jvmargs>
                </properties>
              </configuration>
              <deployables>
                <deployable>
                  <location>${project.build.directory}/${project.build.finalName}</location>
                  <type>war</type>
                  <pingURL>http://localhost:8080/author/.rest/health</pingURL>
                  <pingTimeout>1800000</pingTimeout>
                  <properties>
                    <context>author</context>
                  </properties>
                </deployable>
              </deployables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>runtime</id>
      <properties>
        <magnolia.profile>local-public</magnolia.profile>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.cargo</groupId>
            <artifactId>cargo-maven3-plugin</artifactId>
            <configuration>
              <container>
                <containerId>tomcat11x</containerId>
                <artifactInstaller>
                  <groupId>org.apache.tomcat</groupId>
                  <artifactId>tomcat</artifactId>
                  <version>${tomcat.version}</version>
                  <type>zip</type>
                  <extractDir>${project.build.directory}/../../../tomcat/extracts</extractDir>
                </artifactInstaller>
                <log>${project.build.directory}/../../../tomcat/logs/public/cargo.log</log>
                <output>${project.build.directory}/../../../tomcat/logs/public/tomcat.log</output>
                <timeout>12000000</timeout>
                <append>false</append>
              </container>
              <configuration>
                <home>${project.build.directory}/../../../tomcat/cargo-runtime</home>
                <type>standalone</type>
                <properties>
                  <cargo.servlet.port>8081</cargo.servlet.port>
                  <cargo.rmi.port>8207</cargo.rmi.port>
                  <cargo.logging>medium</cargo.logging>
                  <cargo.tomcat.shutdown.port>8006</cargo.tomcat.shutdown.port>
                  <cargo.tomcat.ajp.port>8010</cargo.tomcat.ajp.port>
                  <cargo.tomcat.shutdown>180000</cargo.tomcat.shutdown>
                  <cargo.jvmargs>
                    -Xms2g
                    -Xmx4g
                    -XX:+UnlockExperimentalVMOptions
                    -XX:+EnableJVMCI
                    -Djava.awt.headless=true
                    -Dsun.io.useCanonCaches=false
                    --add-opens=java.base/java.io=ALL-UNNAMED
                    --add-opens=java.base/java.lang=ALL-UNNAMED
                    --add-opens=java.base/java.lang.reflect=ALL-UNNAMED
                    --add-opens=java.base/java.util=ALL-UNNAMED
                    -DMAGNOLIA_PROFILE=${magnolia.profile}
                    -Dmagnolia.repositories.jackrabbit.config=${magnolia.repositories.jackrabbit.config}
                    -Dmagnolia.repositories.home=${cargo.magnolia.repositories.home}
                    -Dmagnolia.logs.dir=${cargo.magnolia.logs.dir}
                    -Dmagnolia.resources.dir=${cargo.magnolia.resources.dir}
                    -Dmagnolia.license.owner=${magnolia.license.owner}
                    -Dmagnolia.license.key=${magnolia.license.key}
                    -Dmagnolia.superuser.bootstrap.password=${magnolia.superuser.bootstrap.password}
                  </cargo.jvmargs>
                </properties>
              </configuration>
              <deployables>
                <deployable>
                  <location>${project.build.directory}/${project.build.finalName}</location>
                  <type>war</type>
                  <pingURL>http://localhost:8081/.rest/health</pingURL>
                  <pingTimeout>1800000</pingTimeout>
                  <properties>
                    <context>/</context>
                  </properties>
                </deployable>
              </deployables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
