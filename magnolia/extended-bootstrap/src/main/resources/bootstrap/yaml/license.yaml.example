# Example YAML bootstrap file for Enterprise license configuration
# Place this file in: ${magnolia.home}/bootstrap/yaml/license.yaml
# Or configure via: -Dmagnolia.bootstrap.yaml.dir=/path/to/yaml/files

workspace: config
path: /modules/enterprise/license
properties:
  owner: "your-license-owner@example.com"
  key: "your-license-key-here"

