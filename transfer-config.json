{
  "output": {
    "type": "S3",
    "destinationPath": "magnolia-content",
    "settings": {
      "accessKeyId": "YOUR_AWS_ACCESS_KEY_ID",
      "secretAccessKey": "YOUR_AWS_SECRET_ACCESS_KEY",
      "region": "us-east-1"
    },
    "filters": [
      {
        "exclude": "jcr:.*",
        "exceptions": ["jcr:primaryType"]
      },
      {
        "exclude": "mgnl:.*",
        "exceptions": ["mgnl:template"]
      }
    ]
  },
  "workspaces": [
    {
      "workspace": "website",
      "paths": [".*"],
      "mode": "node"
    }
  ]
}