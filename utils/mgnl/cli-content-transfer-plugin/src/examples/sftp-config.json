{
  "output": {
    "type": "SFTP",
    "destinationPath": "/var/magnolia/exports",
    "settings": {
      "host": "sftp.example.com",
      "port": 22,
      "username": "magnolia",
      "password": "your-password-here"
    }
  },
  "workspaces": [
    {
      "workspace": "website",
      "paths": [".*"],
      "mode": "node"
    },
    {
      "workspace": "contacts",
      "paths": [".*"],
      "mode": "combined"
    }
  ]
}

