# AWS Credentials Configuration
# =============================
# Copy this file to aws-credentials.properties and fill in your AWS credentials
# This file is excluded from git to keep credentials secure

# AWS Access Key ID
aws.access.key.id=YOUR_AWS_ACCESS_KEY_ID

# AWS Secret Access Key
aws.secret.access.key=YOUR_AWS_SECRET_ACCESS_KEY

# AWS Region (optional, defaults to us-east-1 if not set)
aws.region=us-east-1

# AWS Profile (optional, if using named profiles from ~/.aws/credentials)
# If set, this will be used instead of access key/secret
# aws.profile=default

# SSH Key Path (optional, defaults to ~/.ssh/{key_pair_name}.pem)
# aws.ssh.key.path=~/.ssh/magnolia-dev-key.pem

# PostgreSQL Password (optional, can also be set via POSTGRES_PASSWORD env var)
# This should match postgres_db_password in terraform.tfvars
# postgres.password=YOUR_POSTGRES_PASSWORD

